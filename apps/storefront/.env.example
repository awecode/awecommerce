NUXT_POSTGRES_URL=postgres://user:password@localhost:5432/awecommerce
# The app's public URL; sign-in links point here
BETTER_AUTH_URL=http://localhost:3000
# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Emails that get the admin (staff) role when they first sign in
NUXT_AUTH_ADMIN_EMAILS=
# Sends sign-in emails. Without them, development prints the email to the console
NUXT_SES_REGION=us-east-1
NUXT_SES_ACCESS_KEY_ID=
NUXT_SES_SECRET_KEY=
NUXT_SES_FROM_EMAIL=
# Signs the order links given at checkout. Generate one with: openssl rand -base64 32
ORDER_HASH_SECRET=
# The shop's public address, for canonical links and sharing previews. Without
# it, the address of each request is used.
NUXT_PUBLIC_SITE_URL=
# The payment methods checkout offers, in this order (see Payments in the
# README). None by default: until some are listed, no order can be placed.
NUXT_PAYMENT_METHODS=cash_on_delivery,pay_later
# Also offer pay later for digital goods when an online method is offered
NUXT_PAY_LATER_WITH_ONLINE=false
# Card payments through Stripe Checkout, once stripe is in NUXT_PAYMENT_METHODS.
# The webhook secret is the signing secret of the endpoint
# {your storefront}/api/store/payments/stripe/webhook (see the README).
NUXT_STRIPE_SECRET_KEY=
NUXT_STRIPE_WEBHOOK_SECRET=
