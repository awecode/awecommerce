NUXT_POSTGRES_URL=postgres://user:password@localhost:5432/awecommerce
# The app's public URL; sign-in links point here.
# 3001, so this can run beside the storefront on 3000 (see devServer.port).
BETTER_AUTH_URL=http://localhost:3001
# Signs sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Emails that get the admin (staff) role when they first sign in
NUXT_AUTH_ADMIN_EMAILS=
# Sends sign-in emails. Without them, development prints the email to the console
NUXT_SES_REGION=us-east-1
NUXT_SES_ACCESS_KEY_ID=
NUXT_SES_SECRET_KEY=
NUXT_SES_FROM_EMAIL=
# The storefront's public address. Shipped and cancelled order emails link to
# the order there (http://localhost:3000 in development); without it, they are
# not sent.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# The same secret as the storefront's, so the order links in those emails open
ORDER_HASH_SECRET=
# Object storage for product images: an S3-compatible bucket. For R2 from
# Node, the endpoint is https://<account>.r2.cloudflarestorage.com, the region
# auto, and the public URL the bucket's public address (images are read from
# there; ACLs are not used). On Cloudflare, an R2 binding named R2 is used
# instead of the keys, with the public URL still set.
NUXT_S3_ACCESS_KEY=
NUXT_S3_SECRET_KEY=
NUXT_S3_BUCKET_NAME=
NUXT_S3_ENDPOINT_URL=
NUXT_S3_REGION=
NUXT_S3_PUBLIC_URL=
