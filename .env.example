# Postgres connection URL. Required by core/db, pnpm migrate, and pnpm seed:product.
POSTGRES_URL=postgres://user:password@localhost:5432/awecommerce

# HMAC secret for order view hashes. Required by OrderService.
# Generate one with: openssl rand -base64 32
ORDER_HASH_SECRET=change-me-to-a-long-random-value

# Optional. Empty Postgres database for tests that need a real server.
# Without it, those tests are skipped.
# TEST_POSTGRES_URL=postgres://user:password@localhost:5432/awecommerce_test

# Optional. Folder with initdb and pg_ctl when they are not on PATH.
# Example: /usr/lib/postgresql/16/bin
# PG_BIN=

# Optional. test makes core/db use an in-memory database. Leave unset for the app.
# NODE_ENV=
