{
  "name": "awecommerce",
  "private": true,
  "description": "Awecommerce monorepo",
  "scripts": {
    "test": "pnpm --filter @awecommerce/service test",
    "coverage": "pnpm --filter @awecommerce/service coverage",
    "build": "pnpm --filter @awecommerce/service build",
    "check:dist": "pnpm --filter @awecommerce/service check:dist",
    "test:pg": "pnpm --filter @awecommerce/service test:pg",
    "typecheck": "pnpm -r typecheck",
    "generate": "pnpm --filter @awecommerce/service generate",
    "migrate": "pnpm --filter @awecommerce/service migrate",
    "seed:product": "pnpm --filter @awecommerce/service seed:product",
    "dev:storefront": "pnpm --filter @awecommerce/storefront dev",
    "dev:backoffice": "pnpm --filter @awecommerce/backoffice dev"
  },
  "packageManager": "pnpm@9.4.0+sha1.9217c800d4ab947a7aee520242a7b70d64fc7638",
  "pnpm": {
    "packageExtensions": {
      "drizzle-kit": {
        "peerDependencies": {
          "drizzle-orm": "*"
        }
      }
    }
  }
}
